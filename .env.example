# Runtime
STREAMLIT_SERVER_PORT=8501

# Observability
SENTRY_DSN=

# Product storage backend: json or sqlite
PRODUCT_STORE_BACKEND=json

# Admin authentication (set salted SHA-256 hash)
ADMIN_PASSWORD_SALT=change_me_salt
ADMIN_PASSWORD_HASH=change_me_hash

# Deployment webhooks
STREAMLIT_DEPLOY_HOOK=
STREAMLIT_STAGING_DEPLOY_HOOK=

# AWS backup settings
AWS_REGION=eu-west-2
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=mall-navigator/sqlite
SQLITE_DB_PATH=data/products.db
